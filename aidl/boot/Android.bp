package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_defaults {
    name: "android.hardware.boot-service_common-samsung",
    relative_install_path: "hw",
    srcs: [
        "main.cpp",
        "BootControl.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
    ],
    static_libs: [
        "android.hardware.boot-V1-ndk",
        "libfstab",
    ],
}

cc_binary {
    name: "android.hardware.boot-service.samsung",
    defaults: ["android.hardware.boot-service_common-samsung"],
    vendor: true,

    init_rc: ["android.hardware.boot-service.samsung.rc"],
    vintf_fragments: ["android.hardware.boot-service.samsung.xml"],
}

cc_binary {
    name: "android.hardware.boot-service.samsung_recovery",
    defaults: ["android.hardware.boot-service_common-samsung"],
    init_rc: ["android.hardware.boot-service.samsung_recovery.rc"],
    vintf_fragments: ["android.hardware.boot-service.samsung.xml"],
    recovery: true,
}
